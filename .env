COMPOSE_PROJECT_NAME=c-fx-17-v2-task1
DEV_NGINX_PORT=80
DEV_ASSESSMENT_PORT=8080

# Non-secret configuration only. Secrets come from ./.env-dev (development,
# gitignored) or /dli/secrets/.env (production), attached via `env_file:` in
# the two compose overlays. See ../secrets.env for the names the pipeline supplies.
NGC_CLI_ORG=nvidia

# --- Deployment model --------------------------------------------------------
# THE COURSE PRE-DEPLOYS (BUILD.md D3). The VSS 3.2.1 `search` profile is brought
# up by the vss-deploy one-shot at launch and must be healthy when the learner's
# environment opens. Learners never deploy on this launch: the notebooks and, at
# the end of Part 1, the coding agent (Codex) work against the running stack.
VSS_STUDENT_DEPLOYS=false

# Images to seed into the course's Docker daemon at launch beyond the VSS profile
# (space-separated). Nothing else pulls images in production: whatever the stack
# expects to find in dind must be listed here.
#   - The three RTVI perception services are the point of the course. dev-profile.sh
#     would pull them at deploy time; seeding them keeps a cold bring-up to engine
#     restores rather than pulls. vss-rt-vlm is NOT pulled by the stock search profile
#     at all (it is patched in, see VSS_ENABLE_RT_VLM), so without this line it is
#     fetched mid-deploy.
#   - The nemotron LLM NIM backs the search agent. Seeded for the same reason.
#   - busybox:1.37.0 is the Docker-in-Docker probe helper. deploy-vss.sh uses it to
#     detect the inner daemon's eth0 address for --host-ip and the dind tests use it.
#     Seeding it avoids an anonymous Docker Hub pull at deploy time.
#   - NOT seeded: nvcr.io/nim/nvidia/cosmos3-reasoner (the critic NIM). ENABLE_CRITIC=false
#     drops it, because the v3.2.1 search profile schedules it onto a nonexistent GPU 2
#     on a 2-GPU host. Course 1 runs no second Cosmos NIM (BUILD.md D4): every VLM call
#     goes to the deployed RT-VLM.
COURSE_EXTRA_IMAGES=nvcr.io/nvidia/vss-core/vss-rt-cv:3.2.1 nvcr.io/nvidia/vss-core/vss-rt-embed:3.2.1 nvcr.io/nvidia/vss-core/vss-rt-vlm:3.2.1 nvcr.io/nim/nvidia/nvidia-nemotron-nano-9b-v2:1 busybox:1.37.0

# --- Launch-time preparation (course-prep one-shot) -------------------------
# How long prepare_course.py waits for http://nginx/agent/health before it raises.
# A cold launch pulls ~93 GB of inner images and the deployer's own cap is 60 min;
# 90 min leaves headroom for a slow registry. The wait prints elapsed time and the
# deployer's status tail every 2 minutes, so a stuck launch is visible in
# `docker compose logs course-prep` long before this fires.
COURSE_PREP_HEALTH_TIMEOUT_S=5400
# How long it then waits, after /complete on all four search clips, for their
# Cosmos-Embed1 records to cover each timeline (one shared wait); OK means
# searchable, not merely accepted. VERIFY ON DEVBOX: the measured /complete-to-
# coverage time for the 180 s clips sets this.
COURSE_PREP_EMBED_TIMEOUT_S=1800
# How long vss-deploy and course-prep each wait for the S3 loader's marker
# (/dli/task/data/.course-data-status.json, written by load-course-data.py) to
# read OK. Compose no longer holds them until s3_data_loader exits, so
# `docker compose up -d` returns while the ~80 GB of model caches download.
# A FAILED marker stops both at once with the loader's error; this cap only
# covers a loader that is still RUNNING. Positive integer seconds.
COURSE_DATA_TIMEOUT_S=5400

# --- VSS ---------------------------------------------------------------------
# First 3.x GA. Do NOT use 3.0.x / 3.1.x: those images, and all 2.x, are
# removed from NGC on 2026-09-30.
VSS_VERSION=3.2.1

# Which upstream developer profile dind brings up. Verified against v3.2.1:
#   base | lvs | search | alerts        (warehouse/edge no longer exist)
#
# `search` is the ONLY v3.2.1 profile that activates RT-Embed (rtvi-embed's
# compose `profiles:` list is exactly ["bp_developer_search_2d"]). It also brings
# up RT-CV, VIOS, Kafka, Logstash and Elasticsearch, four of the five things the
# course needs.
#
# It does NOT bring up RT-VLM: at v3.2.1 rtvi-vlm's `profiles:` list covers
# bp_wh_2d, the two alerts modes, the THOR base profiles and lvs, but NOT
# bp_developer_search_2d. The intersection with rtvi-embed is empty, so no stock
# v3.2.1 profile runs both. deploy/deploy-vss.sh patches rtvi-vlm in via an
# untracked compose.override.yml; see VSS_ENABLE_RT_VLM below.
VSS_PROFILE=search
# Readiness cap for deploy/wait-for-vss.sh, passed through by docker-compose.yml
# (default 3600). Uncomment and set from the measured Friday launch.
# VSS_READY_TIMEOUT_S=3600

# Browser-facing hostname for the VSS UI (upstream's --external-ip). This is NOT
# the same as --host-ip, which is service-to-service inside dind.
#
# LEAVE THIS EMPTY. Every learner gets a different address, so it cannot be
# baked in. Course 1 never opens the VSS UI (nginx no longer proxies it), and
# the notebooks' upload helper (course_setup.upload_url, CONTRACTS.md section 1)
# relies on the VSS agent service returning a `:80/` upload URL, which is what
# an empty external host produces. Setting a value here changes that URL and
# breaks ingest.
VSS_EXTERNAL_HOST=

# The port a BROWSER uses to reach VSS. Deliberately decoupled from the port
# upstream's haproxy binds inside dind (HAPROXY_PORT, 7777). Upstream uses the
# same split for Brev, where it sets 443 and puts an HTTPS proxy in front.
#
# For this course it is ALWAYS 80: nothing else is published on a DLI VM, and
# some corporate networks block high ports outright. The VSS agent service
# builds upload URLs from it (see VSS_EXTERNAL_HOST above).
#
# Unlike VSS_EXTERNAL_HOST this CAN be baked in, because it is a property of the
# platform rather than of a particular learner. It is exported into the lab
# container (see docker-compose.yml) so it is present in the terminal where the
# learner's coding agent runs. `dev-profile.sh` passes its config to compose via
# --env-file, and compose gives the shell environment precedence over that file,
# so this wins over the profile's `VSS_PUBLIC_PORT=${HAPROXY_PORT}` default
# without patching any upstream file.
VSS_PUBLIC_PORT=80

# --- Hardware and GPU budget -------------------------------------------------
# Accepted by v3.2.1: H100 | L40S | RTXPRO4500BW | RTXPRO6000BW | DGX-SPARK |
# IGX-THOR | AGX-THOR | OTHER
HARDWARE_PROFILE=H100

# The lab container runs no model of its own in course 1: every VLM, embedding
# and detection call goes to the deployed stack over http://nginx. Learner
# kernels only decode frames and draw boxes, so the GPU budget below belongs to
# VSS. LAB_DEVICE_ID (bottom of this file) pins the little CUDA work a kernel
# might do to GPU 0.
#
# --- The v3.2.1 search profile assumes THREE GPUs; this box has two ----------
# Upstream ships RT_CV_DEVICE_ID=0, RT_EMBED_DEVICE_ID=1, LLM_DEVICE_ID=1 and
# VLM_DEVICE_ID=2. There is no GPU 2 here. SHARED_LLM_VLM_DEVICE_ID is never
# written anywhere at v3.2.1, so the cosmos3-reasoner NIM critic falls back to
# ${VLM_DEVICE_ID:-0} = "2" and fails to start.
#
# ENABLE_CRITIC=false is upstream's own answer: dev-profile.sh translates it to
# VLM_NAME_SLUG=none and drops the NIM entirely. The critic is not one of the
# three services this course studies, so nothing is lost and a GPU's worth of
# budget is freed for RT-VLM.
ENABLE_CRITIC=false

# Resulting layout, CORRECTED after measuring a live deploy:
#   GPU 0  vss-rtvi-cv (DeepStream RT-DETR + SigLIP2) + vss-vios-nvstreamer
#          + vss-rtvi-vlm
#   GPU 1  vss-rtvi-embed + nemotron LLM NIM
#
# An earlier version of this file put RT-VLM on GPU 1, reasoning that it was the
# "predictable" card because everything on it is fraction-capped. That was
# exactly backwards, and the deployment proved it:
#
#   GPU 1 measured 78.6 GB / 95.8 GB   LLM NIM 38, RT-Embed 13, RT-VLM 25
#   GPU 0 measured  4.4 GB / 95.8 GB   DeepStream is far lighter than assumed
#
# At 0.25 of 96 GB RT-VLM had a 24 GB budget; weights took 16.7 GB and the
# encoder cache most of the rest, leaving 0.46 GB for a KV cache that needs
# 4.5 GB at 32K context. It crash-looped 73 times with:
#
#   ValueError: To serve at least one request with the model's max seq len
#   (32768), 4.50 GiB KV cache is needed, which is larger than the available
#   KV cache memory (0.46 GiB).
#
# On GPU 0 at 0.45 it gets 19.08 GiB of KV cache (138,912 tokens, 4.24x
# concurrency) and initialises in 25 s. This also matches the layout upstream
# itself adopted for `search` on develop.
#
# If you hit this again after changing models, the next lever is
# RTVI_VLM_MAX_MODEL_LEN: dropping 32768 to 8192 cuts the KV requirement from
# ~4.5 GB to ~1.1 GB.
LLM_DEVICE_ID=1
VLM_DEVICE_ID=1
USE_REMOTE_LLM=false
USE_REMOTE_VLM=false

# --- RT-VLM, patched into the search profile ---------------------------------
# Set false to deploy stock search (RT-CV + RT-Embed, no captions).
VSS_ENABLE_RT_VLM=true
VSS_RT_VLM_DEVICE_ID=0
VSS_RT_VLM_PORT=8018
# Cosmos 3 SUPER at FP8. Three model sizes exist on NGC, each published in
# three precisions (weight sizes measured from `ngc registry model list`):
#
#            nvfp4      fp8       bf16
#   Super    20.37 GB   33.08 GB  62.14 GB
#   Nano      7.04 GB    9.87 GB  16.34 GB
#
# Super/fp8 is the course default: the largest reasoner that still shares a
# card with RT-CV. Nano bf16 (16.34 GB) is the fallback if GPU 0 gets crowded.
VSS_RT_VLM_MODEL_PATH=ngc:nim/nvidia/cosmos3-super-reasoner:modelopt-fp8-final_format_fix
# Resolve this pinned model to verified S3-loaded weights before VSS starts.
# Changing the model also requires updating deploy/rt-vlm-checkpoint.json,
# or explicitly setting this false to use the upstream model downloader.
VSS_RT_VLM_USE_S3_CACHE=false
# Seed RT-Embed checkpoint, ONNX exports and H100 NVL TensorRT engines from S3.
# The pinned cache requires the image/GPU/build settings in its manifest.
VSS_RT_EMBED_USE_S3_CACHE=false
# TrafficCamNet + SigLIP models and prebuilt H100 NVL engines.
VSS_RT_CV_USE_S3_CACHE=false
VSS_NEMOTRON_USE_S3_CACHE=false
# MUST be set. Empty makes vLLM claim its default fraction of the whole card.
# 0.65 of 96 GB = ~62 GB: 33 GB of weights, the encoder cache, and roughly a
# 20 GB KV cache at 32K context. RT-CV shares this GPU and needs ~6-12 GB, so
# do not push this past ~0.70. At 0.45 (the Nano setting) Super cannot load.
VSS_RT_VLM_GPU_MEMORY_UTILIZATION=0.65

# --- RT-CV detector -----------------------------------------------------------
# Upstream's search profile runs WAREHOUSE RT-DETR (7 classes: Person, two
# humanoids, Nova_Carter, Transporter, Forklift, Pallet). Course 1 teaches on
# traffic footage in both parts, so RT-CV runs TrafficCamNet RT-DETR instead,
# with 5 classes: background, bicycle, car, person, road_sign. Do not flip this
# to `warehouse` without also publishing its ONNX and engine cache to S3 and
# rewriting Part 1; an optional warehouse activity would need exactly that,
# because running the traffic detector on warehouse footage misleads learners.
#
# NOTE this is NOT upstream's DS_MODEL_FAMILY. At v3.2.1 ds-start.sh accepts only
# rtdetr-warehouse | rtdetr-gdino | sparse4d-warehouse; "smartcity-rtdetr" exists
# only in the standalone detection-tracking SKILL, which is a different deploy
# path. rtdetr-warehouse is the generic RT-DETR dispatch, and the model is chosen
# by ds-pgie-config.yml, which deploy-vss.sh rewrites.
#
#   smartcity = TrafficCamNet RT-DETR   <- this course
#   warehouse = upstream stock, unmodified
VSS_RT_CV_MODEL=smartcity

# DeepStream stream count. Upstream ships 16, which sizes batching and the
# SigLIP2 encoder for a load a classroom never sees. A handful of clips is the
# real workload, and the smaller batch leaves GPU 0 headroom.
VSS_NUM_STREAMS=4

# GPU learner kernels default to. Applied as CUDA_VISIBLE_DEVICES, not
# NVIDIA_VISIBLE_DEVICES: the lab must still SEE every GPU, because notebook 1
# (section 1.4) lists both with nvidia-smi.
LAB_DEVICE_ID=0
