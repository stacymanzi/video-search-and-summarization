# Copy this file to .env and fill in values before running docker compose up.
#   cp .env.example .env
#
# After filling in, also run these host sysctls once (required by Elasticsearch/VSS):
#   sudo sysctl -w vm.max_map_count=262144
#   sudo sysctl -w net.core.somaxconn=65535
# To persist across reboots, add them to /etc/sysctl.conf.

# ── Credentials ───────────────────────────────────────────────────────────────
# NVIDIA NGC API key — https://ngc.nvidia.com/setup/api-key
NGC_CLI_API_KEY=

# HuggingFace token — https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Data directory ─────────────────────────────────────────────────────────────
# Absolute path created by setup.sh. Must NOT use ~ — expand it fully.
# Example: /home/ubuntu/models-and-assets
VSS_LABS_DIR=

# ── JupyterLab ─────────────────────────────────────────────────────────────────
# Leave blank for no token (open access). Set a value to password-protect.
JUPYTER_TOKEN=

# ── Ports ──────────────────────────────────────────────────────────────────────
# Port nginx listens on. Change if 80 is already taken.
NGINX_PORT=80

# ── GPU assignment ─────────────────────────────────────────────────────────────
# GPU the lab notebook kernel uses for local torch workloads.
LAB_DEVICE_ID=0
# GPUs for VSS LLM and VLM services (run on the host daemon).
LLM_DEVICE_ID=1
VLM_DEVICE_ID=1

# ── VSS settings ───────────────────────────────────────────────────────────────
VSS_VERSION=3.2.1
VSS_PROFILE=alerts
HARDWARE_PROFILE=H100
NIM_MODEL_SIZE=nano

# ── Images (override if you have custom builds) ────────────────────────────────
# LAB_IMAGE=nvcr.io/nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04
# VSS_DEPLOY_IMAGE=docker:27-cli
