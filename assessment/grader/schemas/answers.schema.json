{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "/dli/task/work/assessment/answers.json, written by the task cells of part1/assessment.ipynb",
  "type": "object",
  "required": [
    "clip_stem"
  ],
  "properties": {
    "clip_stem": {
      "type": "string",
      "minLength": 1
    },
    "t1": {
      "type": "object",
      "required": [
        "vios_sensor_id",
        "vios_name"
      ],
      "properties": {
        "vios_sensor_id": {
          "type": "string",
          "minLength": 1
        },
        "vios_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "t2": {
      "type": "object",
      "required": [
        "frames",
        "top_type"
      ],
      "properties": {
        "frames": {
          "type": "integer",
          "minimum": 0
        },
        "top_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "t3": {
      "type": "object",
      "required": [
        "sensor_id",
        "frame_id",
        "timestamp"
      ],
      "properties": {
        "sensor_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "t4": {
      "type": "object",
      "required": [
        "file_id",
        "chunks_10",
        "chunks_0",
        "frame_counts_8"
      ],
      "properties": {
        "file_id": {
          "type": "string",
          "minLength": 1
        },
        "chunks_10": {
          "type": "integer",
          "minimum": 0
        },
        "chunks_0": {
          "type": "integer",
          "minimum": 0
        },
        "frame_counts_8": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "t5": {
      "type": "object",
      "required": [
        "query",
        "file",
        "start_s",
        "end_s"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "start_s": {
          "type": "number"
        },
        "end_s": {
          "type": "number"
        }
      }
    },
    "t6": {
      "type": "object",
      "required": [
        "query_object_id",
        "answer_object_id"
      ],
      "properties": {
        "query_object_id": {
          "type": "string",
          "minLength": 1
        },
        "answer_object_id": {
          "type": "string",
          "minLength": 1
        },
        "query_frame_id": {
          "type": "string",
          "minLength": 1
        },
        "query_frame_time": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "t7": {
      "type": "object",
      "required": [
        "latency_ms",
        "requests_per_day",
        "busy_seconds_per_day"
      ],
      "properties": {
        "latency_ms": {
          "type": "number"
        },
        "requests_per_day": {
          "type": "number",
          "minimum": 0
        },
        "busy_seconds_per_day": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "questions": {
      "type": "object"
    }
  }
}
